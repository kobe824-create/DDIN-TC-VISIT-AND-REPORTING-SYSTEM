# Use a PostgreSQL address reachable from every service container.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ddin_tc?schema=public&sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Base64-encoded 32-byte key used to encrypt agent ID and next-of-kin fields.
PII_ENCRYPTION_KEY=generate-a-random-32-byte-base64-key
# Shared one-time password for newly imported TCs; require each person to replace it on first sign-in.
TC_INITIAL_PASSWORD=
# Optional server-side WhatsApp group automation. The TC UI never receives this token.
WHAPI_API_TOKEN=
# Irembo activity feed URL from the DDIN dashboard. Keep the feed URL server-side.
IREMBO_ACTIVITY_FEED_URL=
# Optional server-side Moola Plus agent registry settings. API URLs default to DDIN.
DDIN_REPORTS_API_BASE_URL=https://core-api.ddin.rw/v1/agency/thirdpartyagency/services/reports
DDIN_AGENT_LIST_API_URL=https://core-api.ddin.rw/v1/agency/thirdpartyagency/services/reports/agents/list
DDIN_AGENT_DEPOSITS_API_URL=https://core-api.ddin.rw/v1/agency/thirdpartyagency/services/reports/float/manual-deposit/per-agent
DDIN_FLOAT_BALANCE_API_URL=https://core-api.ddin.rw/v1/agency/thirdpartyagency/services/reports/float/balance
DDIN_API_KEY=
DDIN_AGENT_LIST_CACHE_MS=300000
FRONTEND_URL=https://your-public-app.example
FRONTEND_PORT=5173

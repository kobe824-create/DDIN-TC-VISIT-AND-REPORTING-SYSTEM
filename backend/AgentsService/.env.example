DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ddin_tc?schema=public&sslmode=require
JWT_SECRET=replace-with-the-backend-jwt-secret
# Generate a base64-encoded 32-byte key with: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PORT=3002
NODE_ENV=development
# Keep false until agent registration/imports should be enabled.
AGENT_REGISTRATION_ENABLED=false
REPORTS_SERVICE_URL=http://localhost:3004
# Optional server-side WhatsApp integration token.
WHAPI_API_TOKEN=

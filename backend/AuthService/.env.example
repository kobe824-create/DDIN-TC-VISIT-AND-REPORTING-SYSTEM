# Use the same PostgreSQL database and JWT signing secrets across all backend services.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ddin_tc?schema=public&sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Generate a base64-encoded 32-byte key with: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PORT=3001
NODE_ENV=development
# Optional shared initial password for imported TCs; leave empty to disable.
TC_INITIAL_PASSWORD=

# Optional local demo scripts. Keep both flags false except for intentional local use.
DEMO_SEED_ENABLED=false
DEMO_RESET_ENABLED=false
DEMO_PHOTO_STORAGE_DIR=
